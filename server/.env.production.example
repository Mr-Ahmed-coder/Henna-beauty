# Template only: inject real values through your host's secret manager.
NODE_ENV=production
PORT=5000
# Use 0.0.0.0 only when a container/platform requires it; firewall direct access.
HOST=127.0.0.1
CLIENT_ORIGIN=https://salon.example.com
# Supply a dedicated Atlas/hosted replica-set URI securely; never commit it.
MONGODB_URI=
# Set to the exact trusted proxy hop count only after reviewing network topology.
# Keep 0 for direct access. Prevent direct clients bypassing trusted proxies.
TRUST_PROXY_HOPS=0
SMS_PROVIDER=disabled
SMS_SENDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=disabled
WHATSAPP_SENDER=
WHATSAPP_API_KEY=
