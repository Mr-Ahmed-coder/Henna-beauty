PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# npm run dev manages this persistent local, loopback-only development replica set.
# Set your own Atlas or existing replica-set URI to skip the managed local database.
# Keep credentials only in this ignored .env file or your shell environment.
MONGODB_URI=mongodb://127.0.0.1:27027/salon_dev?replicaSet=salon-dev
